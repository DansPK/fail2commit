{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/run.sh\" session_context.py" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/run.sh\" dangerous_cmd.py" }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/run.sh\" protected_paths.py" },
          { "type": "command", "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/run.sh\" requirement_gate.py" }
        ]
      }
    ]
  }
}
