{
  "description": "Project guards in .codex/hooks/ (identical copy of .claude/hooks/; see its README.md). Review and trust them once with /hooks.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$(git rev-parse --show-toplevel)/.codex/hooks/run.sh\" session_context.py",
            "commandWindows": "python \"$(git rev-parse --show-toplevel)/.codex/hooks/session_context.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$(git rev-parse --show-toplevel)/.codex/hooks/run.sh\" dangerous_cmd.py",
            "commandWindows": "python \"$(git rev-parse --show-toplevel)/.codex/hooks/dangerous_cmd.py\"",
            "timeout": 10,
            "statusMessage": "Checking command"
          }
        ]
      },
      {
        "matcher": "^(apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$(git rev-parse --show-toplevel)/.codex/hooks/run.sh\" protected_paths.py",
            "commandWindows": "python \"$(git rev-parse --show-toplevel)/.codex/hooks/protected_paths.py\"",
            "timeout": 10,
            "statusMessage": "Checking protected paths"
          },
          {
            "type": "command",
            "command": "sh \"$(git rev-parse --show-toplevel)/.codex/hooks/run.sh\" requirement_gate.py",
            "commandWindows": "python \"$(git rev-parse --show-toplevel)/.codex/hooks/requirement_gate.py\"",
            "timeout": 10,
            "statusMessage": "Checking task claim"
          }
        ]
      }
    ]
  }
}
