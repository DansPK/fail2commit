[Unit]
Description=Fail2commit hardened sandbox launcher service
Requires=fail2commit-hardened.socket
After=fail2commit-hardened.socket

[Service]
Type=simple
User=root
Group=root
ExecStart=@EXECUTABLE@ sandbox serve
Restart=on-failure
RestartSec=1s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
# The privileged launcher snapshots peer-owned jobs and applies temporary ACL
# grants only beneath user-owned paths. Keep the rest of the filesystem
# read-only while allowing those exact service data roots and the account's
# home tree to be updated for the duration of a job.
ReadWritePaths=/home /run/fail2commit-hardened /var/lib/fail2commit-hardened /var/lib/fail2commit-hardened-acl
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
